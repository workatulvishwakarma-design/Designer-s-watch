# Database Configuration
# Replace with your local or hosted PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/designerworld?schema=public"

# NextAuth Configuration
# Generate a secret using `openssl rand -base64 32` or similar
AUTH_SECRET="your_secure_random_string_here"
# The canonical URL of your Next.js application (required in production)
NEXTAUTH_URL="http://localhost:3000"

