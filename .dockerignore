# ===========================
# Docker Build Context Ignore
# Designer's Watch - Production
# ===========================

# --- Version Control ---
.git
.gitattributes
.gitignore

# --- Dependencies (rebuilt in container) ---
node_modules

# --- Build Output (rebuilt in container) ---
.next
out
dist
build

# --- IDE / Editor ---
.vscode
.idea
*.swp
*.swo
*~

# --- OS Files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Development Files ---
scratch/
*.tsbuildinfo
next-env.d.ts

# --- Environment (injected at runtime) ---
.env
.env.local
.env.development
.env.production
.env.test

# --- Deployment Configs (not needed in container) ---
netlify.toml
CLIENT_DEMO_CREDENTIALS.md
SETUP.md
README.md

# --- Non-web Assets ---
*.zip
*.psd
*.HEIC
*.pdf

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Test / Coverage ---
coverage/
__tests__/
*.test.*
*.spec.*

# --- Generated Prisma Client (rebuilt via postinstall) ---
src/generated/

# --- Docker ---
Dockerfile
docker-compose*.yml
.dockerignore
