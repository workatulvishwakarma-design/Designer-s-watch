# ===================================================
# Production Environment Variables Template
# Designer's World / D'Signer Watches
# ===================================================

# --- REQUIRED: Database ---
# PostgreSQL connection string (Neon, Supabase, AWS RDS, or local PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# --- REQUIRED: Authentication ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your_strong_random_auth_secret_here"

# The canonical public URL of your deployed application (no trailing slash)
NEXTAUTH_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- PAYMENT GATEWAY: Cashfree (Production / Sandbox) ---
# Get credentials from Cashfree Merchant Dashboard
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="PRODUCTION" # or "SANDBOX" for testing
CASHFREE_API_VERSION="2023-08-01"

# --- SMS SERVICE: MSG91 ---
# Get credentials from https://msg91.com
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="DSGNRW"
MSG91_TPL_ORDER_PLACED=""
MSG91_TPL_PAYMENT_SUCCESS=""
MSG91_TPL_COD_ADVANCE=""
MSG91_TPL_ORDER_SHIPPED=""
MSG91_TPL_OUT_FOR_DELIVERY=""
MSG91_TPL_DELIVERED=""
MSG91_TPL_ORDER_CANCELLED=""

# --- CONTACT & NOTIFICATION EMAILS ---
CONTACT_RECEIVER_EMAIL="info@dsigner.com"

# --- SMTP SERVER (Email Dispatch) ---
# Works with cPanel / Hostinger / Titan / Google Workspace / SendGrid
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Designer's Watch <info@dsigner.com>"

# --- SYSTEM SETTINGS ---
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"
