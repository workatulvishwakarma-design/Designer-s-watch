# ===========================
# Environment Variables Template
# Designer's Watch - Production
# ===========================

# --- REQUIRED: Database ---
# PostgreSQL connection string
# For Coolify internal: use the Coolify PostgreSQL container's internal address
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@coolify-db:5432/designerworld?schema=public"

# --- REQUIRED: Authentication ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="GENERATE_A_SECURE_RANDOM_STRING"

# The public URL of your application
NEXTAUTH_URL="http://187.127.140.26:3000"

# --- OPTIONAL: Payment Gateway ---
# Cashfree (configured in codebase)
# CASHFREE_APP_ID=""
# CASHFREE_SECRET_KEY=""

# Stripe (future)
# STRIPE_PUBLIC_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- OPTIONAL: Shipping ---
# SHIPROCKET_API_KEY=""

# --- OPTIONAL: Node.js ---
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"
